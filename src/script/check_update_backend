#!/bin/bash

readonly ROOT_HOME='/root'
readonly ROOT_BASH_PROFILE_PATH="${ROOT_HOME}/.bash_profile"
readonly ROOT_PROFILE_PATH="${ROOT_HOME}/.profile"

if [ -f "${ROOT_BASH_PROFILE_PATH}" ]; then
	source "${ROOT_BASH_PROFILE_PATH}" >/dev/null 2>&1 || exit 200
elif [ -f "${ROOT_PROFILE_PATH}" ]; then
	source "${ROOT_PROFILE_PATH}" >/dev/null 2>&1 || exit 210
else
	exit 220
fi

#使用するコマンド
readonly CHECK_UPDATE_COMMAND="${EX_CHECK_UPDATE_COMMAND}"
if [ 0 -eq ${#CHECK_UPDATE_COMMAND} ]; then
	echo "チェックコマンド名取得失敗。" 1>&2
	exit 100
fi
readonly CHECK_UPDATE_COMMAND_REFRESH="${EX_CHECK_UPDATE_COMMAND_REFRESH}"
if [ 0 -eq ${#CHECK_UPDATE_COMMAND_REFRESH} ]; then
	echo "リフレッシュコマンドライン取得失敗。" 1>&2
	exit 100
fi
readonly CHECK_UPDATE_COMMAND_UPDATE="${EX_CHECK_UPDATE_COMMAND_UPDATE}"
if [ 0 -eq ${#CHECK_UPDATE_COMMAND_UPDATE} ]; then
	echo "アップデートコマンドライン取得失敗。" 1>&2
	exit 100
fi

#このスクリプトの名前。
readonly MY_NAME=$(basename "${0}")

#ロックファイルのパス
readonly _lockfile="/tmp/${MY_NAME}.lock"

function log_and_exit() {
	local -r YMD_VAL=$(date +%Y%m%d%H%M%S)
	echo "${YMD_VAL}_${1}_${3}" >>"${2}"
	exit "${3}"
}

function wait_5_min() {
	sleep 300
}

readonly LOGDIR="/var/log/update-check-log"
readonly LOGFILE="${LOGDIR}/$(date +%Y%m%d%H%M%S)_${CHECK_UPDATE_COMMAND}.log"
mkdir -p "${LOGDIR}" && chmod 755 "${LOGDIR}" || exit 1

wait_5_min

echo "$(date +%Y%m%d%H%M%S)_開始します。" >>"${LOGFILE}"

#ロックファイル生成。
echo "$(date +%Y%m%d%H%M%S)_ロックファイル生成。" >>"${LOGFILE}"
exec 9>"${_lockfile}"
if ! flock -n 9; then
	echo "$(date +%Y%m%d%H%M%S)_Cannot run multiple instance." >>"${LOGFILE}"
	exit 110
fi

# ファイル更新日時が5000日を越えたログファイルを削除
echo "$(date +%Y%m%d%H%M%S)_旧ログ削除。" >>"${LOGFILE}"
readonly PARAM_DATE_NUM=5000
find "${LOGDIR}" -name "*.log" -type f -mtime +"${PARAM_DATE_NUM}" -exec rm -f {} \;

readonly UPDATE_PROC_LIST=$(pgrep -l "${CHECK_UPDATE_COMMAND}" | grep -v grep | grep -v "${MY_NAME}")
readonly UPDATE_PROC_COUNT=$(echo "${UPDATE_PROC_LIST}" | grep -v '^\s*$' | wc -l)
if [ "${UPDATE_PROC_COUNT}" != 0 ]; then
	log_and_exit "${CHECK_UPDATE_COMMAND}が起動中です。終了します。" "${LOGFILE}" 2
fi

echo "$(date +%Y%m%d%H%M%S)_チェック開始。" >>"${LOGFILE}"

${CHECK_UPDATE_COMMAND_REFRESH} >> "${LOGFILE}" 2>&1 && \
${CHECK_UPDATE_COMMAND_UPDATE} >> "${LOGFILE}" 2>&1

readonly RET_COMMAND="${?}"
if [ "${RET_COMMAND}" -ne 0 ]; then
	echo "$(date +%Y%m%d%H%M%S)_${CHECK_UPDATE_COMMAND_REFRESH} && ${CHECK_UPDATE_COMMAND_UPDATE}の戻り値が${RET_COMMAND}です。" >>"${LOGFILE}"
fi

echo "$(date +%Y%m%d%H%M%S)_チェック終了。" >>"${LOGFILE}"

log_and_exit "正常終了します。" "${LOGFILE}" 0
